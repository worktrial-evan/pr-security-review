# copy to .env and fill in. bun loads .env on every run
# the key for anthropic/ model ids in config/models.json
ANTHROPIC_API_KEY=
# the key for fireworks/ model ids in config/models.json
FIREWORKS_API_KEY=
# optional. raises the GitHub API limit and opens private repositories
GITHUB_TOKEN=
# the absolute path of the cache folder in the main checkout, such as /Users/<you>/Projects/pr-review/cache
# every worktree under .claude/worktrees then shares one cache. falls back to ~/.cache/pull-request-review when unset
PULL_REQUEST_REVIEW_CACHE_DIR=
