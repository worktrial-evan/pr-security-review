{
  // One composite project per module. The references are this module's row of the
  // allowed-imports matrix in .dependency-cruiser.cjs, so bun check rejects an import
  // from any other module with TS6307
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/typescript/reachability"
  },
  "include": ["./**/*.ts"],
  // The sample repository imports packages that are not installed, so it stays out of bun check
  "exclude": ["./fixtures/sample-repo"],
  "references": [{ "path": "../shared" }]
}
