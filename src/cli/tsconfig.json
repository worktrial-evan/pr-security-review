{
  // One composite project per module. The references are this module's row of the
  // allowed-imports matrix in .dependency-cruiser.cjs, so bun check rejects an import
  // from any other module with TS6307
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/typescript/cli"
  },
  "include": ["./**/*.ts"],
  "references": [
    { "path": "../shared" },
    { "path": "../pipeline" },
    { "path": "../report" },
    { "path": "../benchmark" },
    { "path": "../harness" },
    { "path": "../server" },
    { "path": "../advisories" },
    { "path": "../matcher" },
    { "path": "../pull-request-source" }
  ]
}
