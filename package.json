{
  "name": "pr-review",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:headers": "bun scripts/check-file-headers.ts",
    "verify": "bun check && biome check . && bun run check:boundaries && bun run check:headers && bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fission-ai/openspec": "1.14.2",
    "@types/bun": "1.4.3",
    "@types/semver": "7.8.0",
    "dependency-cruiser": "18.6.0",
    "lefthook": "2.2.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.81",
    "@ai-sdk/fireworks": "3.0.73",
    "ai": "7.0.142",
    "commander": "15.0.0",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  }
}
